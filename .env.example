# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
# Local MongoDB (Default for testing without Atlas account)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lending

# MongoDB Atlas Cloud (Uncomment and replace username, password, and cluster)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_lending?retryWrites=true&w=majority

# Session Security
SESSION_SECRET=supersecretcampuslendingkey_change_in_production
COOKIE_SECURE=false

# Google OAuth 2.0 Credentials (Google Cloud Console Web Client)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# Production redirect URI: https://YOUR-DOMAIN.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Facebook / Meta Login Credentials (Meta for Developers)
# Authorized redirect URI: http://localhost:3000/auth/facebook/callback
# Production redirect URI: https://YOUR-DOMAIN.com/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Gmail OTP Configuration (Required to send real OTP emails)
# 1. Enable 2-Step Verification in Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Campus UPI Payment Gateway Settings
DEFAULT_UPI_ID=campus.equipment@icici
UPI_MERCHANT_NAME=Campus Equipment Exchange

# OpenRouter AI Configuration (Activate live LLM neural responses)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Application Settings
AI_ASSISTANT_NAME=Campus Equipment Advisor
ADMIN_INVITE_CODE=CAMPUS_ADMIN_SECURE_2026
