# --------------------------------------------------
# APPLICATION
# --------------------------------------------------

NODE_ENV=development

PORT=3000

BASE_URL=http://localhost:3000


# --------------------------------------------------
# DATABASE
# --------------------------------------------------

MONGODB_URI=mongodb://127.0.0.1:27017/SIH2026


# --------------------------------------------------
# SESSION
# --------------------------------------------------

SESSION_SECRET=replace_with_a_long_random_secret


# --------------------------------------------------
# EMAIL / OTP
# --------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

EMAIL_FROM=Campus Exchange <your_email@gmail.com>

# Replace with your real institutional domain(s)
INSTITUTIONAL_EMAIL_DOMAINS=yourcollege.edu

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Use true ONLY for local testing without SMTP.
# In demo mode the OTP is printed to the terminal.
OTP_DEMO_MODE=false


# --------------------------------------------------
# PAYMENT
# Phase 4
# --------------------------------------------------

UPI_ID=your_upi_id


# --------------------------------------------------
# OPTIONAL AI
# Phase 6
# --------------------------------------------------

AI_API_KEY=