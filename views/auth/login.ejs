<%- include("../partials/head", { title: "Login" }) %>

<link
  rel="stylesheet"
  href="/css/login.css?v=7e2"
/>


<main class="auth-page">

  <div class="auth-background"></div>


  <section
    class="auth-card"
    aria-labelledby="login-title"
  >

    <!-- =====================================================
         BRAND
         ===================================================== -->

    <div class="auth-brand">

      <a
        href="/"
        class="auth-brand-link"
        aria-label="Campus Exchange Home"
      >

        <span class="auth-brand-mark">
          CE
        </span>

        <span class="auth-brand-text">

          <strong>
            Campus Exchange
          </strong>

          <small>
            Campus Equipment Lending
          </small>

        </span>

      </a>

    </div>


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="auth-header">

      <p class="auth-eyebrow">
        CAMPUS EXCHANGE
      </p>

      <h1 id="login-title">
        Welcome back
      </h1>

      <p class="auth-subtitle">
        Login to continue to your campus equipment account.
      </p>

    </div>


    <!-- =====================================================
         SUCCESS MESSAGE
         ===================================================== -->

    <% if (
      typeof message !== "undefined" &&
      message
    ) { %>

      <div
        class="auth-alert auth-alert-success"
        role="status"
      >
        <%= message %>
      </div>

    <% } %>


    <!-- =====================================================
         ERROR MESSAGE
         ===================================================== -->

    <% if (
      typeof error !== "undefined" &&
      error
    ) { %>

      <div
        class="auth-alert auth-alert-error"
        role="alert"
      >
        <%= error %>
      </div>

    <% } %>


    <!-- =====================================================
         LOGIN FORM
         ===================================================== -->

    <form
      method="POST"
      action="/auth/login"
      class="auth-form"
    >

      <!-- EMAIL -->

      <div class="auth-field">

        <label for="email">
          Institutional Email
        </label>

        <input
          type="email"
          id="email"
          name="email"
          placeholder="you@college.edu"
          autocomplete="email"
          required
        >

      </div>


      <!-- PASSWORD -->

      <div class="auth-field">

        <label for="password">
          Password
        </label>

        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        >

      </div>


      <!-- LOGIN BUTTON -->

      <button
        type="submit"
        class="auth-submit"
      >
        Login
      </button>

    </form>


    <!-- =====================================================
         SIGNUP
         ===================================================== -->

    <div class="auth-footer">

      <span>
        Don't have an account?
      </span>

      <a href="/auth/register">
        Create one
      </a>

    </div>


  </section>

</main>


<%- include("../partials/footer") %>