<%- include("../partials/head", { title }) %>

<style>
/* ==================================================
   PHASE 6 — AI HARDWARE ASSISTANT
   INLINE STYLE TO GUARANTEE LOADING
   ================================================== */

.ai-page {
  min-height: calc(100vh - 70px);
  padding: 56px 20px 90px;
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(49, 92, 245, 0.08),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 10%,
      rgba(91, 112, 255, 0.07),
      transparent 28%
    ),
    #f5f7fb;
}

.ai-container {
  width: min(1120px, 100%);
  margin: 0 auto;
}

/* HERO */

.ai-hero {
  max-width: 820px;
  margin: 0 auto 38px;
  text-align: center;
}

.ai-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 13px;
  border: 1px solid #d6e0ff;
  border-radius: 999px;
  background: #eef3ff;
  color: #315cf5;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.ai-eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #315cf5;
}

.ai-hero h1 {
  margin: 18px 0 12px;
  color: #10254a;
  font-size: clamp(38px, 6vw, 58px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -.035em;
}

.ai-hero p {
  max-width: 740px;
  margin: 0 auto;
  color: #66738a;
  font-size: 16px;
  line-height: 1.75;
}

/* ASSISTANT */

.assistant-card {
  width: min(920px, 100%);
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid #dce3ef;
  border-radius: 24px;
  background: #ffffff;
  box-shadow:
    0 24px 65px rgba(24, 45, 83, .09),
    0 4px 16px rgba(24, 45, 83, .04);
}

.assistant-header {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 82px;
  padding: 17px 22px;
  border-bottom: 1px solid #e9edf4;
  background: #fff;
}

.assistant-avatar {
  width: 50px;
  height: 50px;
  flex: 0 0 50px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: linear-gradient(135deg,#315cf5,#6280ff);
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  box-shadow: 0 9px 22px rgba(49,92,245,.25);
}

.assistant-title {
  flex: 1;
}

.assistant-title h2 {
  margin: 0;
  color: #10254a;
  font-size: 19px;
}

.assistant-title p {
  margin: 4px 0 0;
  color: #7a8698;
  font-size: 13px;
}

.assistant-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border: 1px solid #d9efe2;
  border-radius: 999px;
  background: #f0faf4;
  color: #24834b;
  font-size: 11px;
  font-weight: 700;
}

.assistant-status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2cab62;
}

/* CHAT */

.chat-messages {
  min-height: 340px;
  max-height: 540px;
  overflow-y: auto;
  padding: 28px;
  background: #f8faff;
}

.chat-message {
  max-width: 82%;
  margin-bottom: 22px;
}

.assistant-message {
  margin-right: auto;
}

.user-message {
  margin-left: auto;
}

.message-label {
  margin-bottom: 7px;
  color: #8a95a7;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.message-bubble {
  padding: 15px 17px;
  border-radius: 17px;
  font-size: 14px;
  line-height: 1.6;
  word-break: break-word;
}

.assistant-message .message-bubble {
  border: 1px solid #dbe4ff;
  border-top-left-radius: 6px;
  background: #edf2ff;
  color: #18345f;
}

.user-message .message-bubble {
  border-top-right-radius: 6px;
  background: #315cf5;
  color: #fff;
  box-shadow: 0 8px 20px rgba(49,92,245,.18);
}

/* QUICK BUTTONS */

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 15px;
}

.suggestion-chip {
  border: 1px solid #cad6f2;
  border-radius: 999px;
  background: #fff;
  padding: 9px 13px;
  color: #315cf5;
  cursor: pointer;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
}

.suggestion-chip:hover {
  border-color: #315cf5;
  background: #f6f8ff;
}

/* FORM */

.assistant-form {
  padding: 19px 21px 21px;
  border-top: 1px solid #e9edf4;
  background: #fff;
}

.assistant-form textarea {
  display: block;
  width: 100%;
  min-height: 105px;
  box-sizing: border-box;
  resize: vertical;
  padding: 15px 16px;
  border: 1px solid #d4dce9;
  border-radius: 15px;
  outline: none;
  background: #fff;
  color: #1b2d4d;
  font-family: inherit;
  font-size: 14px;
  line-height: 1.55;
}

.assistant-form textarea:focus {
  border-color: #315cf5;
  box-shadow: 0 0 0 4px rgba(49,92,245,.10);
}

.input-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 11px;
}

.character-count {
  color: #8c97a8;
  font-size: 12px;
}

.ai-submit-button {
  min-width: 155px;
  height: 45px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 0;
  border-radius: 12px;
  background: #315cf5;
  color: #fff;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 800;
  box-shadow: 0 8px 20px rgba(49,92,245,.22);
}

.ai-submit-button:hover {
  opacity: .92;
}

.ai-submit-button:disabled {
  cursor: wait;
  opacity: .65;
}

/* RECOMMENDATIONS */

.recommendation-section {
  width: 100%;
  margin-top: 50px;
}

.section-heading {
  margin-bottom: 21px;
}

.section-heading h2 {
  margin: 9px 0 6px;
  color: #10254a;
  font-size: clamp(25px,4vw,34px);
  font-weight: 800;
  letter-spacing: -.025em;
}

.section-heading p {
  margin: 0;
  color: #748095;
  font-size: 14px;
}

.recommendation-grid {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 20px;
}

.recommendation-card {
  overflow: hidden;
  border: 1px solid #dce4ef;
  border-radius: 19px;
  background: #fff;
  box-shadow: 0 14px 32px rgba(25,45,79,.06);
}

.recommendation-image {
  width: 100%;
  height: 190px;
  overflow: hidden;
  display: grid;
  place-items: center;
  background: #edf2f8;
}

.recommendation-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recommendation-placeholder {
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: #315cf5;
  color: #fff;
  font-size: 24px;
  font-weight: 800;
}

.recommendation-body {
  padding: 19px;
}

.recommendation-category {
  color: #315cf5;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.recommendation-body h3 {
  margin: 8px 0;
  color: #10254a;
  font-size: 20px;
}

.recommendation-description {
  min-height: 46px;
  margin: 0;
  color: #6b778a;
  font-size: 13px;
  line-height: 1.6;
}

.recommendation-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin: 17px 0;
}

.recommendation-detail {
  padding: 10px;
  border-radius: 11px;
  background: #f7f9fc;
}

.recommendation-detail span {
  display: block;
  color: #8d98a9;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
}

.recommendation-detail strong {
  display: block;
  margin-top: 4px;
  color: #203453;
  font-size: 13px;
}

.recommendation-reason {
  margin: 0 0 15px;
  color: #59667b;
  font-size: 12px;
  line-height: 1.55;
}

.recommendation-button {
  width: 100%;
  min-height: 43px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  background: #315cf5;
  color: #fff;
  text-decoration: none;
  font-size: 13px;
  font-weight: 800;
}

/* EMPTY */

.no-result-section {
  margin-top: 42px;
  padding: 45px 20px;
  border: 1px dashed #cdd7e6;
  border-radius: 20px;
  background: #fff;
  text-align: center;
}

.no-result-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  margin: 0 auto 16px;
  border-radius: 50%;
  background: #edf2ff;
  color: #315cf5;
  font-size: 22px;
  font-weight: 800;
}

.no-result-section h2 {
  margin: 0 0 8px;
  color: #10254a;
  font-size: 23px;
}

.no-result-section p {
  max-width: 560px;
  margin: 0 auto 20px;
  color: #6d798d;
  font-size: 14px;
  line-height: 1.6;
}

.secondary-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 16px;
  border: 1px solid #d3dce9;
  border-radius: 11px;
  background: #fff;
  color: #1e365b;
  text-decoration: none;
  font-size: 13px;
  font-weight: 800;
}

.hidden {
  display: none !important;
}

/* RESPONSIVE */

@media (max-width: 920px) {
  .recommendation-grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 650px) {

  .ai-page {
    padding: 35px 14px 60px;
  }

  .ai-hero h1 {
    font-size: 39px;
  }

  .assistant-card {
    border-radius: 18px;
  }

  .assistant-status {
    display: none;
  }

  .chat-messages {
    padding: 18px;
  }

  .chat-message {
    max-width: 94%;
  }

  .input-bottom {
    align-items: stretch;
    flex-direction: column;
  }

  .ai-submit-button {
    width: 100%;
  }

  .recommendation-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<%- include("../partials/header") %>


<main class="ai-page">

  <div class="ai-container">

    <!-- HERO -->

    <section class="ai-hero">

      <div class="ai-eyebrow">
        <span class="ai-eyebrow-dot"></span>
        AI HARDWARE ASSISTANT
      </div>

      <h1>
        Tell me what you want to build.
      </h1>

      <p>
        Describe your project, measurement task,
        or hardware requirement. The assistant searches
        the real Campus Exchange equipment inventory.
      </p>

    </section>


    <!-- ASSISTANT -->

    <section class="assistant-card">

      <div class="assistant-header">

        <div class="assistant-avatar">
          AI
        </div>

        <div class="assistant-title">

          <h2>
            Hardware Assistant
          </h2>

          <p>
            Database-connected recommendations
          </p>

        </div>

        <div class="assistant-status">
          <span></span>
          Online
        </div>

      </div>


      <!-- CHAT -->

      <div
        id="chatMessages"
        class="chat-messages"
        aria-live="polite"
      >

        <div class="chat-message assistant-message">

          <div class="message-label">
            Assistant
          </div>

          <div class="message-bubble">

            <div class="message-text">
              Hi! Tell me what hardware or
              project you need help with.
            </div>

            <div class="suggestion-row">

              <button
                type="button"
                class="suggestion-chip"
                data-question="I need to measure weight for my project"
              >
                ⚖️ Measure weight
              </button>

              <button
                type="button"
                class="suggestion-chip"
                data-question="I need to measure voltage"
              >
                ⚡ Measure voltage
              </button>

              <button
                type="button"
                class="suggestion-chip"
                data-question="I want to make a temperature monitoring project"
              >
                🌡️ Temperature project
              </button>

            </div>

          </div>

        </div>

      </div>


      <!-- INPUT -->

      <form
        id="assistantForm"
        class="assistant-form"
      >

        <textarea
          id="assistantMessage"
          name="message"
          rows="3"
          maxlength="1000"
          placeholder="Example: I need to measure weight for my project..."
          required
        ></textarea>

        <div class="input-bottom">

          <span
            id="characterCount"
            class="character-count"
          >
            0 / 1000
          </span>

          <button
            type="submit"
            id="assistantSubmit"
            class="ai-submit-button"
          >
            <span>➤</span>
            Ask Assistant
          </button>

        </div>

      </form>

    </section>


    <!-- RECOMMENDATIONS -->

    <section
      id="recommendationSection"
      class="recommendation-section hidden"
    >

      <div class="section-heading">

        <div class="ai-eyebrow">
          RECOMMENDATIONS
        </div>

        <h2>
          Equipment from your campus inventory
        </h2>

        <p>
          These recommendations come from the
          equipment currently stored in MongoDB.
        </p>

      </div>

      <div
        id="recommendationGrid"
        class="recommendation-grid"
      ></div>

    </section>


    <!-- NO RESULTS -->

    <section
      id="noResultSection"
      class="no-result-section hidden"
    >

      <div class="no-result-icon">
        ?
      </div>

      <h2>
        No matching available equipment
      </h2>

      <p>
        Try describing the measurement, project,
        component, or hardware you need.
      </p>

      <a
        href="/search"
        class="secondary-action"
      >
        Open Smart Search
      </a>

    </section>

  </div>

</main>

<script src="/js/chatbot.js?v=6"></script>