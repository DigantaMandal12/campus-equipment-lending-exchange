<header class="site-header">
  <div class="container header-inner">

    <a
      href="/"
      class="brand"
      aria-label="Campus Exchange Home"
    >
      <span class="brand-mark">CE</span>

      <span class="brand-text">
        Campus Exchange
      </span>
    </a>

    <nav
      class="nav"
      aria-label="Primary navigation"
    >
      <a href="/">Home</a>

      <a href="/health">
        Health
      </a>

      <% if (currentUser) { %>

        <span class="nav-user">
          Hi, <%= currentUser.name %>
        </span>

        <form
          action="/auth/logout"
          method="POST"
          class="logout-form"
        >
          <button
            type="submit"
            class="nav-button"
          >
            Logout
          </button>
        </form>

      <% } else { %>

        <a href="/auth/login">
          Login
        </a>

        <a href="/auth/register">
          Register
        </a>

      <% } %>

    </nav>

  </div>
</header>