<%- include("partials/head", { title }) %>

<%- include("partials/header") %>

<main>

  <!-- HERO -->
  <section class="hero-section">

    <div class="container hero-grid">

      <div class="hero-content">

        <span class="eyebrow">
          HACKATHON PROJECT
        </span>

        <h1>
          Peer-to-Peer Academic
          Equipment Lending
        </h1>

        <p class="hero-description">
          A campus marketplace where students can
          discover, request, borrow, return and rate
          academic equipment.
        </p>

       <div class="hero-actions">

  <% if (currentUser) { %>

    <a
      href="/dashboard"
      class="btn btn-primary"
    >
      Open Dashboard
    </a>

  <% } else { %>

    <a
      href="/auth/register"
      class="btn btn-primary"
    >
      Create Account
    </a>

    <a
      href="/auth/login"
      class="btn btn-secondary"
    >
      Login
    </a>

  <% } %>

  <a
    href="#architecture"
    class="btn btn-secondary"
  >
    View Architecture
  </a>

</div>

      </div>

      <div class="status-card">

        <div class="status-card-header">
          <span>System Status</span>
          <span class="status-dot"></span>
        </div>

        <div class="status-row">
          <span>Architecture</span>
          <strong>MVC</strong>
        </div>

        <div class="status-row">
          <span>Backend</span>
          <strong>Express.js</strong>
        </div>

        <div class="status-row">
          <span>Frontend</span>
          <strong>EJS + CSS + JS</strong>
        </div>

        <div class="status-row">
          <span>Database</span>
          <strong>MongoDB</strong>
        </div>

        <div class="status-row">
          <span>Deployment</span>
          <strong>Vercel</strong>
        </div>

      </div>

    </div>

  </section>


  <!-- CURRENT PHASE -->
  <section class="section">

    <div class="container">

      <div class="section-heading">
        <span class="eyebrow">CURRENT PHASE</span>

        <h2>
          <%= currentPhase %>
        </h2>

        <p>
          The foundation is intentionally being completed
          before authentication, borrowing and payment
          functionality are introduced.
        </p>
      </div>

      <div class="feature-grid">

        <article class="feature-card">
          <span class="feature-number">01</span>
          <h3>Clean Architecture</h3>
          <p>
            Routes, controllers, services and models
            will remain separated as the application grows.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-number">02</span>
          <h3>Database Ready</h3>
          <p>
            MongoDB connection handling is prepared
            for the upcoming persistent application features.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-number">03</span>
          <h3>Deployment Ready</h3>
          <p>
            The Express application is structured so
            local and Vercel execution can coexist.
          </p>
        </article>

      </div>

    </div>

  </section>


  <!-- ARCHITECTURE -->
  <section
    id="architecture"
    class="section section-alt"
  >

    <div class="container">

      <div class="section-heading">
        <span class="eyebrow">ARCHITECTURE</span>

        <h2>Request Flow</h2>
      </div>

      <div class="architecture-flow">

        <div class="architecture-node">
          <span>01</span>
          <strong>Browser</strong>
          <small>HTML / CSS / JS</small>
        </div>

        <div class="flow-arrow">→</div>

        <div class="architecture-node">
          <span>02</span>
          <strong>Routes</strong>
          <small>HTTP endpoints</small>
        </div>

        <div class="flow-arrow">→</div>

        <div class="architecture-node">
          <span>03</span>
          <strong>Controllers</strong>
          <small>Request handling</small>
        </div>

        <div class="flow-arrow">→</div>

        <div class="architecture-node">
          <span>04</span>
          <strong>Services</strong>
          <small>Business logic</small>
        </div>

        <div class="flow-arrow">→</div>

        <div class="architecture-node">
          <span>05</span>
          <strong>Models</strong>
          <small>MongoDB / Mongoose</small>
        </div>

      </div>

    </div>

  </section>

</main>

<%- include("partials/footer") %>