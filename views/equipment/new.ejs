<%- include("../partials/head", { title }) %>

<%- include("../partials/header") %>

<main class="form-page">

  <div class="container">

    <div class="form-card">

      <div class="form-card-heading">

        <span class="eyebrow">
          LENDER
        </span>

        <h1>
          Add Equipment
        </h1>

        <p>
          List an academic item that other students can borrow.
        </p>

      </div>

      <% if (error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
      <% } %>

      <form
        action="/equipment"
        method="POST"
        class="auth-form"
      >

        <div class="equipment-form-grid">

          <div class="form-group">

            <label for="name">
              Equipment Name
            </label>

            <input
              id="name"
              type="text"
              name="name"
              value="<%= formData.name %>"
              placeholder="Mechanical Draftor"
              required
            >

          </div>


          <div class="form-group">

            <label for="category">
              Category
            </label>

            <input
              id="category"
              type="text"
              name="category"
              value="<%= formData.category %>"
              placeholder="Engineering Drawing"
              required
            >

          </div>


          <div class="form-group">

            <label for="department">
              Engineering Department
            </label>

            <input
              id="department"
              type="text"
              name="department"
              value="<%= formData.department %>"
              placeholder="Mechanical Engineering"
              required
            >

          </div>


          <div class="form-group">

            <label for="condition">
              Condition
            </label>

            <select
              id="condition"
              name="condition"
              required
            >

              <option
                value="NEW"
                <%= formData.condition === "NEW" ? "selected" : "" %>
              >
                New
              </option>

              <option
                value="LIKE_NEW"
                <%= formData.condition === "LIKE_NEW" ? "selected" : "" %>
              >
                Like New
              </option>

              <option
                value="GOOD"
                <%= formData.condition === "GOOD" ? "selected" : "" %>
              >
                Good
              </option>

              <option
                value="FAIR"
                <%= formData.condition === "FAIR" ? "selected" : "" %>
              >
                Fair
              </option>

              <option
                value="NEEDS_REPAIR"
                <%= formData.condition === "NEEDS_REPAIR" ? "selected" : "" %>
              >
                Needs Repair
              </option>

            </select>

          </div>


          <div class="form-group">

            <label for="quantity">
              Quantity
            </label>

            <input
              id="quantity"
              type="number"
              name="quantity"
              min="1"
              step="1"
              value="<%= formData.quantity %>"
              required
            >

          </div>


          <div class="form-group">

            <label for="rentalFee">
              Borrow / Rental Fee (₹)
            </label>

            <input
              id="rentalFee"
              type="number"
              name="rentalFee"
              min="0"
              step="0.01"
              value="<%= formData.rentalFee %>"
              required
            >

          </div>


          <div class="form-group">

            <label for="securityDeposit">
              Security Deposit (₹)
            </label>

            <input
              id="securityDeposit"
              type="number"
              name="securityDeposit"
              min="0"
              step="0.01"
              value="<%= formData.securityDeposit %>"
              required
            >

          </div>


          <div class="form-group form-field-full">

            <label for="description">
              Description
            </label>

            <textarea
              id="description"
              name="description"
              placeholder="Describe the equipment, its use and important details."
              required
            ><%= formData.description %></textarea>

          </div>


          <div class="form-group form-field-full">

            <label for="borrowingTerms">
              Borrowing Terms
            </label>

            <textarea
              id="borrowingTerms"
              name="borrowingTerms"
              placeholder="Example: Return within 7 days. Keep equipment dry."
            ><%= formData.borrowingTerms %></textarea>

          </div>

        </div>


        <button
          type="submit"
          class="btn btn-primary btn-full"
        >
          Publish Equipment
        </button>

      </form>

    </div>

  </div>

</main>

<%- include("../partials/footer") %>