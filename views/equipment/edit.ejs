<%- include("../partials/head", { title }) %>

<%- include("../partials/header") %>

<main class="form-page">

  <div class="container">

    <div class="form-card">

      <div class="form-card-heading">

        <span class="eyebrow">
          LENDER
        </span>

        <h1>
          Edit Equipment
        </h1>

        <p>
          Update your equipment listing.
        </p>

      </div>


      <% if (error) { %>

        <div class="alert alert-error">
          <%= error %>
        </div>

      <% } %>


      <form
        action="/equipment/<%= equipment._id %>/update"
        method="POST"
        enctype="multipart/form-data"
        class="auth-form"
      >

        <div class="equipment-form-grid">


          <!-- Equipment Name -->
          <div class="form-group">

            <label for="name">
              Equipment Name
            </label>

            <input
              id="name"
              type="text"
              name="name"
              value="<%= equipment.name %>"
              minlength="2"
              maxlength="120"
              required
            >

          </div>


          <!-- Category -->
          <div class="form-group">

            <label for="category">
              Category
            </label>

            <input
              id="category"
              type="text"
              name="category"
              value="<%= equipment.category %>"
              maxlength="100"
              required
            >

          </div>


          <!-- Department -->
          <div class="form-group">

            <label for="department">
              Engineering Department
            </label>

            <input
              id="department"
              type="text"
              name="department"
              value="<%= equipment.department %>"
              maxlength="100"
              required
            >

          </div>


          <!-- Condition -->
          <div class="form-group">

            <label for="condition">
              Condition
            </label>

            <select
              id="condition"
              name="condition"
              required
            >

              <option
                value="NEW"
                <%= equipment.condition === "NEW" ? "selected" : "" %>
              >
                New
              </option>

              <option
                value="LIKE_NEW"
                <%= equipment.condition === "LIKE_NEW" ? "selected" : "" %>
              >
                Like New
              </option>

              <option
                value="GOOD"
                <%= equipment.condition === "GOOD" ? "selected" : "" %>
              >
                Good
              </option>

              <option
                value="FAIR"
                <%= equipment.condition === "FAIR" ? "selected" : "" %>
              >
                Fair
              </option>

              <option
                value="NEEDS_REPAIR"
                <%= equipment.condition === "NEEDS_REPAIR" ? "selected" : "" %>
              >
                Needs Repair
              </option>

            </select>

          </div>


          <!-- Quantity -->
          <div class="form-group">

            <label for="quantity">
              Total Quantity
            </label>

            <input
              id="quantity"
              type="number"
              name="quantity"
              min="1"
              step="1"
              value="<%= equipment.quantity %>"
              required
            >

            <small class="form-help">
              Total physical stock.
            </small>

          </div>


          <!-- Rental Fee -->
          <div class="form-group">

            <label for="rentalFee">
              Borrow / Rental Fee (₹)
            </label>

            <input
              id="rentalFee"
              type="number"
              name="rentalFee"
              min="0"
              step="0.01"
              value="<%= equipment.rentalFee %>"
              required
            >

          </div>


          <!-- Security Deposit -->
          <div class="form-group">

            <label for="securityDeposit">
              Security Deposit (₹)
            </label>

            <input
              id="securityDeposit"
              type="number"
              name="securityDeposit"
              min="0"
              step="0.01"
              value="<%= equipment.securityDeposit %>"
              required
            >

          </div>


          <!-- Current Availability -->
          <div class="form-group">

            <label for="currentAvailability">
              Current Availability
            </label>

            <input
              id="currentAvailability"
              type="text"
              value="<%= equipment.availableQuantity %> / <%= equipment.quantity %>"
              disabled
            >

            <small class="form-help">
              Available / Total
            </small>

          </div>


          <!-- Current Status -->
          <div class="form-group">

            <label for="currentStatus">
              Current Status
            </label>

            <input
              id="currentStatus"
              type="text"
              value="<%= equipment.status %>"
              disabled
            >

          </div>


          <!-- Description -->
          <div class="form-group form-field-full">

            <label for="description">
              Description
            </label>

            <textarea
              id="description"
              name="description"
              minlength="10"
              maxlength="2000"
              required
            ><%= equipment.description %></textarea>

          </div>


          <!-- Existing Images -->
          <div class="form-group form-field-full">

            <label>
              Current Equipment Photos
            </label>

            <% if (Array.isArray(equipment.images) && equipment.images.length > 0) { %>

              <div class="equipment-image-gallery">

                <% equipment.images.forEach(function(image) { %>

                  <div class="equipment-image-item">

                    <img
                      src="<%= image %>"
                      alt="<%= equipment.name %>"
                      loading="lazy"
                    >

                  </div>

                <% }); %>

              </div>

            <% } else { %>

              <p class="form-help">
                No photos have been uploaded yet.
              </p>

            <% } %>

          </div>


          <!-- New Images -->
          <div class="form-group form-field-full">

            <label for="images">
              Add More Equipment Photos
            </label>

            <input
              id="images"
              type="file"
              name="images"
              accept="image/jpeg,image/png,image/webp"
              multiple
              data-max-files="5"
              data-max-size="2097152"
            >

            <small class="form-help">
              You can add up to 5 new images. Each image must be 2 MB or smaller.
            </small>

            <div
              id="image-preview"
              class="equipment-image-preview"
              aria-live="polite"
            ></div>

          </div>


          <!-- Borrowing Terms -->
          <div class="form-group form-field-full">

            <label for="borrowingTerms">
              Borrowing Terms
            </label>

            <textarea
              id="borrowingTerms"
              name="borrowingTerms"
              maxlength="2000"
            ><%= equipment.borrowingTerms %></textarea>

          </div>

        </div>


        <button
          type="submit"
          class="btn btn-primary btn-full"
        >
          Save Changes
        </button>

      </form>


      <div style="margin-top: 14px;">

        <a
          href="/equipment/<%= equipment._id %>"
          class="btn btn-secondary btn-full"
        >
          Cancel
        </a>

      </div>

    </div>

  </div>

</main>

<%- include("../partials/footer") %>